{
	"expo": {
		"name": "lework",
		"slug": "lework-mobile",
		"scheme": "lework",
		"version": "0.1.0",
		"orientation": "portrait",
		"userInterfaceStyle": "automatic",
		"android": {
			"package": "com.insmtx.lework",
			"predictiveBackGestureEnabled": false,
			"usesCleartextTraffic": true
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			["expo-camera", { "cameraPermission": "允许 lework 扫描配对二维码" }],
			["expo-notifications", { "color": "#0f172a" }]
		],
		"experiments": {
			"typedRoutes": false
		}
	}
}
